{
  "name": "stashov-personal-ai",
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "env": {
    "NEBIUS_API_KEY": "@nebius_api_key",
    "NEBIUS_BASE_URL": "https://api.tokenfactory.nebius.com/v1",
    "MODEL_ULTRA": "nvidia/Nemotron-3-Ultra-550b-a55b",
    "MODEL_SUPER": "nvidia/Nemotron-3-Super-120b-a12b",
    "MODEL_NANO": "nvidia/Nemotron-3-Nano-30B-A3B",
    "MODEL_LIGHTNING": "nvidia/Nemotron-3.5-Lightning",
    "MODEL_VISION": "zai-org/GLM-5.3-Flash",
    "MODEL_EMBEDDING": "Qwen/Qwen3-Embedding-8B"
  }
}
# Nebius Token Factory Configuration (OpenAI-Compatible API)
NEBIUS_API_KEY=your_nebius_token_factory_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Model Routing Tiers on Nebius Token Factory
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_SUPER=nvidia/Nemotron-3-Super-120b-a12b
MODEL_NANO=nvidia/Nemotron-3-Nano-30B-A3B
MODEL_LIGHTNING=nvidia/Nemotron-3.5-Lightning
MODEL_VISION=zai-org/GLM-5.3-Flash
MODEL_EMBEDDING=Qwen/Qwen3-Embedding-8B

# Archil durable disk (server-side only — never expose this key to the browser)
# API key from https://console.archil.com/api-keys — starts with key-, not a disk/mount token
ARCHIL_API_KEY=
ARCHIL_REGION=aws-us-east-1
# dsk-… id of the disk used by lib/archil-disk.js; `npm run archil-check` prints it
ARCHIL_DISK_ID=

# Optional Telegram Bot for 2-Second Mobile Capture & Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server network
# Bind to loopback by default. If you set HOST=0.0.0.0 (Render, LAN, Docker),
# set STASHOV_ACCESS_TOKEN too or the server refuses to start.
HOST=127.0.0.1
PORT=3847

# Access control. Required for any non-loopback deployment.
# The browser unlocks at /unlock and stores an HttpOnly session cookie.
STASHOV_ACCESS_TOKEN=
# Set when the service is reached through a reverse proxy or custom domain.
# Example: https://stashov.example.com
STASHOV_PUBLIC_ORIGIN=

# Set to 1 only for a trusted private network you intentionally leave open.
STASHOV_ALLOW_INSECURE_NETWORK=0

# Optional: store vault data outside the repo (recommended for shared checkouts)
# STASHOV_DATA_DIR=/absolute/path/to/stashov-data

# Vercel Blob persistence. On Vercel, connect a Blob store to the project and
# Vercel injects BLOB_STORE_ID automatically. For Vercel-compatible hosts,
# set BLOB_READ_WRITE_TOKEN instead. Without either, writes go to /tmp and
# are lost when the serverless instance recycles.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
